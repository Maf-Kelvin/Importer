# .env.example — copy to .env and fill in all required values
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────
SECRET_KEY=                          # Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
POSTGRES_USER=import_user
POSTGRES_PASSWORD=                   # Generate a strong random password
POSTGRES_DB=import_logistics
FLOWER_PASSWORD=                     # Generate a strong random password
GRAFANA_PASSWORD=                    # Generate a strong random password

# ── Database ──────────────────────────────────────────────────────────
# Docker Compose uses these variables to construct DATABASE_URL.
# This URL connects through PgBouncer using transaction pooling.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}
DATABASE_PGBOUNCER=true

# ── Redis ─────────────────────────────────────────────────────────────
# State Redis: Celery broker, locks, idempotency keys and token blacklist.
# Uses noeviction policy; do not use this Redis instance for disposable cache data.
REDIS_URL=redis://redis:6379/0

# Cache Redis: dashboards and FX rates only.
# Uses allkeys-lru; cache data can safely be evicted.
CACHE_REDIS_URL=redis://redis-cache:6379/0

# Required in production if Redis authentication is enabled.
# Production Compose must construct matching authenticated Redis URLs.
REDIS_PASSWORD=

# ── Celery ────────────────────────────────────────────────────────────
# Keep broker and result backend on separate Redis databases.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── App settings ──────────────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────
# Only needed if the frontend is served from a DIFFERENT origin than the API.
# The bundled setup (Vite proxy in development, Nginx in production) is same-origin.
# List exact origins; do not use a wildcard when requests carry credentials.
# The refresh cookie is SameSite=Strict, so a separate frontend should be on the same site.
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ── External APIs ─────────────────────────────────────────────────────
MSC_API_KEY=
EXCHANGERATE_API_KEY=

# ── Object storage ────────────────────────────────────────────────────
STORAGE_BACKEND=local                # local | s3 | r2
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp                  # smtp | sendgrid | mailgun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAILS_FROM_EMAIL=

# ── Monitoring ───────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── First superuser (initialization script only) ──────────────────────
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=            # Set a strong password before initialization.

# ── Production domain ─────────────────────────────────────────────────
DOMAIN=yourdomain.com

# Public self-registration (POST /auth/register).
# Keep false in production unless public registration is intentional.
REGISTRATION_OPEN=false

# Set true only when the application is behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Idempotency storage backend.
IDEMPOTENCY_BACKEND=postgres         # postgres (durable, default) | redis
