# .env.example — copy to .env and fill in all required values
# Never commit .env to version control

# ── Required ──────────────────────────────────────────────────────────
SECRET_KEY=                          # python -c "import secrets; print(secrets.token_urlsafe(64))"
POSTGRES_USER=import_user
POSTGRES_PASSWORD=                   # strong random password
POSTGRES_DB=import_logistics
FLOWER_PASSWORD=                     # strong random password
GRAFANA_PASSWORD=                    # strong random password

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=                      # set in production

# ── Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── App settings ─────────────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── External APIs ─────────────────────────────────────────────────────
MSC_API_KEY=
EXCHANGERATE_API_KEY=

# ── Object storage ────────────────────────────────────────────────────
STORAGE_BACKEND=local                # local | s3 | r2
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp                  # smtp | sendgrid | mailgun | ses
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAILS_FROM_EMAIL=

# ── Monitoring ───────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── First superuser (init script only) ───────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=            # change immediately after first login

# ── Production domain ─────────────────────────────────────────────────
DOMAIN=yourdomain.com