# .env.example — copy to .env and fill in all required values
# Never commit .env to version control

# ── Required ──────────────────────────────────────────────────────────
SECRET_KEY=                          # python -c "import secrets; print(secrets.token_urlsafe(64))"
POSTGRES_USER=import_user
POSTGRES_PASSWORD=                   # strong random password
POSTGRES_DB=import_logistics
FLOWER_PASSWORD=                     # strong random password
GRAFANA_PASSWORD=                    # strong random password

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────────────
# State Redis: Celery broker, locks, idempotency keys, token blacklist (noeviction)
REDIS_URL=redis://redis:6379/0
# Cache Redis: dashboards and FX rates only (allkeys-lru, safe to lose)
CACHE_REDIS_URL=redis://redis-cache:6379/0
REDIS_PASSWORD=                      # required in production; the prod compose file builds the URLs from it
DATABASE_PGBOUNCER=true              # true when DATABASE_URL points at PgBouncer (transaction pooling)

# ── Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── App settings ─────────────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────
# Only needed if the frontend is served from a DIFFERENT origin than the API. The bundled setup
# (Vite proxy in development, Nginx in production) is same-origin, so CORS is not used at all.
# List exact origins (no wildcard, because requests carry credentials). The refresh cookie is
# SameSite=Strict, so a separate frontend must be on the same SITE (e.g. app.example.com + api.example.com).
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── External APIs ─────────────────────────────────────────────────────
MSC_API_KEY=
EXCHANGERATE_API_KEY=

# ── Object storage ────────────────────────────────────────────────────
STORAGE_BACKEND=local                # local | s3 | r2
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp                  # smtp | sendgrid | mailgun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAILS_FROM_EMAIL=

# ── Monitoring ───────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── First superuser (init script only) ───────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=            # change immediately after first login

# ── Production domain ─────────────────────────────────────────────────
DOMAIN=yourdomain.com
# Public self-registration (POST /auth/register). Leave false in production.
REGISTRATION_OPEN=false
TRUST_PROXY_HEADERS=false           # true only behind Nginx (audit log IP address)
IDEMPOTENCY_BACKEND=postgres        # postgres (durable, default) | redis
